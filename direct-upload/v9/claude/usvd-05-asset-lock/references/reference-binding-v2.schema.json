{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USVDS reference binding v2",
  "type": "object",
  "required": [
    "asset_id",
    "asset_version_id",
    "binding_id",
    "controls",
    "input_slot",
    "media_path",
    "must_not_control",
    "order",
    "purpose",
    "sha256",
    "shot_ids",
    "status",
    "video_id"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_version_id": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "media_path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "shot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "enum": [
        "appearance",
        "subject",
        "look_state",
        "spatial_layout",
        "composition",
        "scale",
        "effect",
        "first_frame",
        "last_frame",
        "style"
      ]
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_not_control": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_slot": {
      "enum": [
        "reference_images",
        "start_frame",
        "end_frame"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "resolved",
        "pending"
      ]
    },
    "pending_reason": {
      "type": "string"
    },
    "crop": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
