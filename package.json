{
  "name": "@jimwoocory/dsh-us-vertical-drama-studio",
  "version": "0.4.0-v9-preview.1",
  "description": "No-UI DeepSeek Harness plugin for the US Vertical Drama Studio V9 full workflow: controller and stages 01–09.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dsh-plugin/index.js",
  "exports": {
    ".": "./dsh-plugin/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.1"
  },
  "files": [
    "dsh-plugin/index.js",
    "plugins/us-vertical-drama-studio-v9",
    "core/usvd-v9",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:v9": "node scripts/sync-v9-distributions.mjs",
    "build:dsh-v9": "node scripts/sync-dsh-v9.mjs",
    "check:v9": "node scripts/sync-v9-distributions.mjs --check",
    "test": "node scripts/sync-v9-distributions.mjs --check && node --test dsh-plugin/test/*.test.mjs && node --check dsh-plugin/client.bundle.cjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "vertical-drama",
    "screenwriting"
  ]
}
